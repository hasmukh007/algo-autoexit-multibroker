# Kotak Neo API Configuration
# Get these credentials from Kotak Neo Web / App -> Trade API Dashboard

# Mode: 'live' or 'mock' (mock mode allows testing UI and auto-exit without live credentials)
TRADING_MODE=mock

# Live Kotak Neo API Credentials:
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=

# Optional TOTP Secret (Base32 string from QR code). If provided, backend generates TOTP automatically!
# If left empty, you can enter the 6-digit TOTP manually in the UI upon login.
KOTAK_TOTP_SECRET=

# Base URL (default is https://mis.kotaksecurities.com)
KOTAK_BASE_URL=https://mis.kotaksecurities.com

# Server Port
PORT=3000

# Auto-Exit Risk Management Defaults
DEFAULT_MAX_LOSS_INR=2000
DEFAULT_TARGET_PROFIT_INR=5000
DEFAULT_AUTO_SQUAREOFF_TIME=15:15
